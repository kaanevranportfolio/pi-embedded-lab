# Allow-list: everything is ignored unless listed below.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/docs/

!/yocto-lab/
/yocto-lab/*
!/yocto-lab/meta-lab/
!/yocto-lab/local.conf.sample

!/buildroot-lab/
/buildroot-lab/*
!/buildroot-lab/lab.fragment.in
!/buildroot-lab/board/
!/buildroot-lab/overlay/
/buildroot-lab/overlay/root/.ssh/authorized_keys

!/piproj/
/piproj/*
!/piproj/CMakeLists.txt
!/piproj/cmake/
!/piproj/src/
!/piproj/tools/
/piproj/tools/pimon-out/

*.log
*.bak*
__pycache__/
/piproj/tools/rec-out/
